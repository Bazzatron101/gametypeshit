  - id: packmaster
    displayName: Packmaster
    rank: B
    parent: beastcaller
    description: 'Leads a pack that hunts as one. Call Wolves has a 30% shorter cooldown. Summon skills deal 15% more damage. New skills: Call Dire Wolves (level 56), Howl (level 62).'
    passives:
    - {fileID: 11400000, guid: 60db2bc1a8edada4dba5bf363ff0ddcc, type: 2}
