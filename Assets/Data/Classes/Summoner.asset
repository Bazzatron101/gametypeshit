  specialties:
  - id: beastcaller
    displayName: Beastcaller
    rank: D
    parent: 
    description: 'Fights beside a pack of beasts. Call Wolves deals 30% more damage. Summon skills have 15% shorter cooldowns. New skill: Call Bear (level 16).'
