    - {fileID: 11400000, guid: 4c08246f4eed58142809e279731fc63f, type: 2}
    - {fileID: 11400000, guid: ce856daa75ca5ad43935e8e35ada955d, type: 2}
  - id: necromancer
    displayName: Necromancer
    rank: B
    parent: spiritbinder
    description: 'The fallen rise again, and fight for it. Call Wraith deals 30% more damage. Summon skills have 15% shorter cooldowns. New skills: Raise Dead (level 56), Bone Spear (level 62).'
