  - id: golemancer
    displayName: Golemancer
    rank: B
    parent: beastcaller
    description: 'Raises giants of stone to stand in front of the party. Call Golem deals 35% more damage and has a 20% shorter cooldown. Area skills deal 15% more damage. New skills: Call Colossus (level 56), Tremor (level 62).'
