  id: warrior
  displayName: Warrior
  description: Front line. Heavy blades and the health to stand in the fight. +1 Strength, +1 Vitality each level.
  strength: 1
  agility: 0
  vitality: 1
  intelligence: 0
  sense: 0
  luck: 0
