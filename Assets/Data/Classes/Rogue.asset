  m_Name: Rogue
  m_EditorClassIdentifier: HunterSystem.Game::HunterSystem.Game.ClassDefinitionAsset
  id: rogue
  displayName: Rogue
  description: Quick knives up close, and a leap that clears an enemy's charge. +1 Agility, +1 Luck each level.
  strength: 0
  agility: 1
  vitality: 0
  intelligence: 0
  sense: 0
  luck: 1
