  specialties:
  - id: hexer
    displayName: Hexer
    rank: D
    parent: 
    description: 'Drains its enemies dry, up close. Drain Touch deals 30% more damage. Magic skills have 10% shorter cooldowns. New skill: Wither (level 16).'
    passives:
    - {fileID: 11400000, guid: 7dd0e7c2cfafb204bac9a135dec602e5, type: 2}
    - {fileID: 11400000, guid: f303982621c30cf48875c977e9462b46, type: 2}
  - id: shadowcaller
    displayName: Shadowcaller
    rank: D
    parent: 
    description: 'Calls the dark down on a crowd. Void Rupture covers 1 m more around it. Shadow Bolt fires 1 more bolt in a fan. New skill: Shadow Burst (level 16).'
    passives:
    - {fileID: 11400000, guid: ee1a6f47562c4e041abde2e58d63d21c, type: 2}
    - {fileID: 11400000, guid: 1031f561a8089d846a75886214ca0fd4, type: 2}
  - id: soul-reaper
    displayName: Soul Reaper
    rank: B
    parent: hexer
    description: 'Cuts down the weak and grows stronger for it. Soul Siphon deals 35% more damage. Magic skills deal 10% more damage. New skills: Reap (level 56), Harvest Souls (level 62).'
    passives:
    - {fileID: 11400000, guid: 69fae96a2f153204082d592748236eaa, type: 2}
    - {fileID: 11400000, guid: 4c0f24fb7a30b854199d067e18403f53, type: 2}
  - id: blood-mage
    displayName: Blood Mage
    rank: B
    parent: hexer
    description: 'Spends blood freely, and always takes more back. Drain Touch has a 30% shorter cooldown. Shadow Bolt deals 30% more damage. New skills: Blood Lance (level 56), Crimson Tide (level 62).'
    passives:
    - {fileID: 11400000, guid: 1859797aef4a672488bb54453a2c6445, type: 2}
    - {fileID: 11400000, guid: e8207c367e9d41d44b57dcc82619d1c3, type: 2}
  - id: voidlord
    displayName: Voidlord
    rank: B
    parent: shadowcaller
    description: 'Opens the void and lets it swallow the fight. Void Rupture deals 30% more damage. Area skills deal 15% more damage. New skills: Black Hole (level 56), Void Spike (level 62).'
    passives:
    - {fileID: 11400000, guid: 9241f66286245024285cb36cbd785947, type: 2}
    - {fileID: 11400000, guid: 10f49106f1d08a54cb4cadf9538dc6c3, type: 2}
  - id: doombringer
    displayName: Doombringer
    rank: B
    parent: shadowcaller
    description: 'Every spell is a slow, certain end. Abyssal Wave deals 25% more damage and reaches 2 m further. Magic skills have 15% shorter cooldowns. New skills: Doom (level 56), Cataclysm (level 62).'
    passives:
