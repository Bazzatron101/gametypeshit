    - {fileID: 11400000, guid: ce65def77453c79438d9b3ce183db2b6, type: 2}
    - {fileID: 11400000, guid: fdfce88034ab72c46b22cc54da7a6036, type: 2}
  - id: storm-dancer
    displayName: Storm Dancer
    rank: B
    parent: wind-walker
    description: 'A whirl of kicks that never lets up. Flurry of Fists has a 25% shorter cooldown and covers 1 m more around it. Melee skills have 10% shorter cooldowns. New skills: Cyclone Kick (level 56), Thunder Step (level 62).'
