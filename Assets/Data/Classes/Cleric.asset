  specialties:
  - id: priest
    displayName: Priest
    rank: D
    parent: 
    description: 'Keeps the party standing. Mending Light restores 30% more health. Sanctuary covers 1.5 m more around it. New skill: Greater Mending (level 16).'
    passives:
    - {fileID: 11400000, guid: b1e9835b2e622ba47b090716551a1e65, type: 2}
